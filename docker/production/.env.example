# FunWind 生产 · app 编排 env 模板（/opt/funwind/app/.env，chmod 600，不入库）
# 全量变量说明见仓库根 .env.example；此处只列生产必填与与开发不同的值。
# 密钥一律真实生成后填入本文件；本模板不含任何真实值。

# —— 数据库（连独立编排的容器，funwind-internal 网络内经容器名直连）——
NEW_DB_HOST=funwind-mysql
NEW_DB_PORT=3306
NEW_DB_USER=root
NEW_DB_PASSWORD=<与 docker/mysql/.env 的 MYSQL_ROOT_PASSWORD 一致>
NEW_DB_NAME=qingyisub

# —— 站点 ——
APP_URL=https://www.qingyisub.top
# 反代后取真实 Client IP 必填（M12 F3：nginx 一层，1 跳）
TRUSTED_PROXY_HOPS=1

# —— 邮件（阿里云 DM；SMTP_URL 内嵌凭据，勿入 git）——
SMTP_URL=smtp://<用户名>:<密码>@smtpdm.aliyun.com:465
MAIL_FROM=青翼字幕组 <noreply@qingyisub.top>

# —— 密钥类（openssl rand -base64 32 生成；会话令牌不依赖应用密钥，无需配置）——
THEME_PREVIEW_SECRET=<生成；单实例可留空，多实例必填（G-17-4）>
# 其余按仓库根 .env.example 清单核对（M13 上线检查单走查；OLD_DB_* 仅迁移期需要）

# 运维任务管线管理入口（M14；OPS_API_TOKEN 与管线 .env 的 OPS_TOKEN 同值，openssl rand -base64 24 生成）
OPS_API_TOKEN=
