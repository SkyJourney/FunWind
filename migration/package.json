{
  "name": "qysub-migration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "phpwind 9 (GBK) → qysub_next (utf8mb4) 幂等迁移程序",
  "scripts": {
    "schema": "tsx src/load-schema.ts",
    "migrate": "tsx src/run.ts",
    "migrate:only": "tsx src/run.ts",
    "verify": "tsx src/verify.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
