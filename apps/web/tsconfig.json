{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "cn": ["./src/lib/utils.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-e2e-prod/types/**/*.ts",
    ".next-e2e-prod/dev/types/**/*.ts",
    ".next-size/types/**/*.ts",
    ".next-size/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-e2e",
    ".next-e2e-prod",
    "e2e",
    "e2e-dev",
    "e2e-prod",
    "test-results"
  ]
}
