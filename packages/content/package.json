{
  "name": "@funwind/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "内容层纯函数：门控语法（拆分 / 还原 / 校验）、正文按门控占位切段，以及转换器 ⇄ 渲染器共用的语法契约；迁移与线上保存共用同一套门控语法（UBB 转换器在 migration/，不在本包）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "mdast-util-directive": "^3.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
