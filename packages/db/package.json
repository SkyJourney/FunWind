{
  "name": "@funwind/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "schema 单一事实源：Drizzle 定义 + 版本化 SQL 迁移 + bootstrap/seed/verify（决策 #10）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "build": "tsc -p tsconfig.build.json",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "seed": "tsx scripts/seed.ts",
    "e2e-fixtures": "tsx scripts/e2e-fixtures.ts",
    "verify": "tsx scripts/verify.ts",
    "recount": "tsx scripts/recount.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "SKIP_DB_TESTS=1 vitest run"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
