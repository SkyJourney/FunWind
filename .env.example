# ===== 复制为 .env 后填入真实值（.env 已被 .gitignore 排除） =====

# 旧库（只读红线：程序内强制只允许 SELECT/SHOW/DESC）
OLD_DB_HOST=127.0.0.1
OLD_DB_PORT=33620
OLD_DB_USER=root
OLD_DB_PASSWORD=changeme
OLD_DB_NAME=qingyisub

# 新库（MySQL 8.4 LTS, utf8mb4, InnoDB）
NEW_DB_HOST=127.0.0.1
NEW_DB_PORT=33621
NEW_DB_USER=root
NEW_DB_PASSWORD=changeme
NEW_DB_NAME=qysub_next

# 文件存储根目录（内容寻址：<STORAGE_DIR>/ab/cd/<sha256>.<ext>）。web 的 /files 路由读取、迁移程序写入。
# 缺省为 <仓库根>/storage/（已 gitignore）。可平移到对象存储。
STORAGE_DIR=

# 以下两项**仅迁移程序使用**（读取旧站磁盘上的附件与表情），web 运行时不再依赖
# 旧附件目录（只读引用）
ATTACHMENT_DIR=/Volumes/Docker/data/qingyisub/wwwroot/www.qingyisub.top/attachment

EMOTION_DIR=/Volumes/Docker/data/qingyisub/wwwroot/www.qingyisub.top/res/images/emotion

# 每批行数
BATCH_SIZE=2000

# 邮件（M4）：SMTP 连接串 + 发件人 + 站点地址（邮件链接用）
# dev 推荐 MailPit smtp://127.0.0.1:1025；生产如阿里云邮件推送用隐式 SSL：smtps://用户名(URL编码):密码@smtpdm.aliyun.com:465（From 地址必须与认证账号一致）
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=青翼字幕组 <noreply@qingyisub.top>
APP_URL=http://127.0.0.1:3100

# 可信反向代理层数（审计/频控取客户端 IP 用）：X-Forwarded-For 从右数第 N 项才可信。
# 取不到可信 IP 时（本项为 0 / 链路异常）会跳过 IP 级频控，只保留账号级与邮箱级限额——
# 不能让所有未知来源共用一个桶，否则攻击者占满它就能让全站用户无法登录。
# 生产环境必须显式设置（漏配会在首次取 IP 时直接报错）：nginx 等代理之后填实际层数；直连无代理填 0。
TRUSTED_PROXY_HOPS=0

# 全站主题预览签名密钥（M11.1：后台「全站预览」10 分钟 cookie 的 HMAC 密钥）。
# 缺省用进程内随机密钥（单实例部署足够）；多实例部署必须显式配置同一值，否则预览只在签发实例有效。
THEME_PREVIEW_SECRET=

# 进程内定时任务调度器（M11.5，见 docs/SCHEDULED-JOBS.md）。默认关闭，**只有精确的 on 才启动**（ON、1、true、留空都不启动）。
# 在且仅在承载定时任务的实例上设为 on；多个实例同时开也安全（任务执行前用 MySQL 命名锁互斥）。
# 开发与测试不要开：开发库连的是真实 SMTP，E2E 的生产构建也是 next start，定时任务会踩到正在测试的数据。
SCHEDULER=

# 注销清理每批行数（M11.5；默认 50，一般无需设置）
# ACCOUNT_DELETION_BATCH_SIZE=50

# 备份服务管理入口（M13 运维功能；/admin/ops 触发与下载用）
# BACKUP_SERVICE_URL：备份服务容器内地址（生产固定 http://funwind-backup:8000；本地未部署则不设）
# BACKUP_OPS_TOKEN：与备份服务 .env 的 OPS_TOKEN 一致（openssl rand -base64 24 生成）
# BACKUP_SERVICE_URL=
# BACKUP_OPS_TOKEN=

# 静态站标回退（M13 F9；一般无需设置）：顶栏 LOGO 优先取后台 LOGO 池当前项（/brand/logo），
# 池为空时才回退到静态素材——填「-112/-224 双档文件名的公共前缀」（public/logo/ 下），
# 如 qy-二次元-03清爽侦探动画（对应 -112.png / -224.png），留空显示 Wind 占位。
# 注意 NEXT_PUBLIC_* 在 build 期内联：生产镜像需在构建时提供才生效。
# 上线默认站标由 `pnpm init-brand`（导入路径）/安装管线（零数据路径）写入 LOGO 池，无需依赖本项。
# NEXT_PUBLIC_LOGO=
