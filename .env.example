# ===== 复制为 .env 后填入真实值（.env 已被 .gitignore 排除） =====

# 旧库（只读红线：程序内强制只允许 SELECT/SHOW/DESC）
OLD_DB_HOST=127.0.0.1
OLD_DB_PORT=33620
OLD_DB_USER=root
OLD_DB_PASSWORD=changeme
OLD_DB_NAME=qingyisub

# 新库（MySQL 8.4 LTS, utf8mb4, InnoDB）
NEW_DB_HOST=127.0.0.1
NEW_DB_PORT=33621
NEW_DB_USER=root
NEW_DB_PASSWORD=changeme
NEW_DB_NAME=qysub_next

# 文件存储根目录（内容寻址：<STORAGE_DIR>/ab/cd/<sha256>.<ext>）。web 的 /files 路由读取、迁移程序写入。
# 缺省为 <仓库根>/storage/（已 gitignore）。可平移到对象存储。
STORAGE_DIR=

# 以下两项**仅迁移程序使用**（读取旧站磁盘上的附件与表情），web 运行时不再依赖
# 旧附件目录（只读引用）
ATTACHMENT_DIR=/Volumes/Docker/data/qingyisub/wwwroot/www.qingyisub.top/attachment

EMOTION_DIR=/Volumes/Docker/data/qingyisub/wwwroot/www.qingyisub.top/res/images/emotion

# 每批行数
BATCH_SIZE=2000

# 邮件（M4）：SMTP 连接串（dev 推荐 MailPit smtp://127.0.0.1:1025）+ 发件人 + 站点地址（邮件链接用）
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=青翼字幕组 <noreply@qingyisub.top>
APP_URL=http://127.0.0.1:3100

# 可信反向代理层数（审计/频控取客户端 IP 用）：X-Forwarded-For 从右数第 N 项才可信。
# 取不到可信 IP 时（本项为 0 / 链路异常）会跳过 IP 级频控，只保留账号级与邮箱级限额——
# 不能让所有未知来源共用一个桶，否则攻击者占满它就能让全站用户无法登录。
# 生产环境必须显式设置（漏配会在首次取 IP 时直接报错）：nginx 等代理之后填实际层数；直连无代理填 0。
TRUSTED_PROXY_HOPS=0
